{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "linkedin-skills": {
      "source": {
        "source": "github",
        "repo": "sergebulaev/linkedin-skills"
      }
    },
    "openseo": {
      "source": {
        "source": "github",
        "repo": "every-app/open-seo"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "caveman@caveman": true,
    "linkedin-skills@linkedin-skills": true,
    "openseo@openseo": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-warning.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/client-tag.py\""
          }
        ]
      }
    ]
  }
}
