     var ci = res && res.customerInfo;
     return !!(ci && ci.entitlements && ci.entitlements.active && ci.entitlements.active[C.ENTITLEMENT_ID]);
   }
-  function openApp() {
-    if (MOCK) { document.body.innerHTML = "<p style='padding:40px;font:16px sans-serif'>Unlocked. The app would now open " + C.APP_URL + "</p>"; return; }
-    window.location.replace(C.APP_URL);
+  /* Remember (on this device) that the person chose "log in to your account" */
+  var FLAG = "ftlr_web_login";
+  function getFlag() { try { return localStorage.getItem(FLAG) === "1"; } catch (e) { return false; } }
+  function setFlag(v) { try { if (v) localStorage.setItem(FLAG, "1"); else localStorage.removeItem(FLAG); } catch (e) {} }
+  var backFromApp = /[?&]back=1/.test(location.search);
+  if (backFromApp) setFlag(false);
+
+  /* ftlr_verify=0: opened because of an Apple purchase. ftlr_verify=1: account log in path. */
+  function openApp(verify) {
+    var url = C.APP_URL + (C.APP_URL.indexOf("?") > -1 ? "&" : "?") + "ftlr_verify=" + (verify ? "1" : "0");
+    if (MOCK) { document.body.innerHTML = "<p style='padding:40px;font:16px sans-serif'>Unlocked. The app would now open " + url + "</p>"; return; }
+    window.location.replace(url);
   }
 
   /* ---------- paywall rendering ---------- */
@@ -195,7 +200,7 @@
     if (!selected || busy) return;
     tap(); say(""); setBusy(true);
     Purchases.purchasePackage({ aPackage: selected }).then(function (res) {
-      if (isPremium(res)) { openApp(); } else { setBusy(false); say("Purchase finished but access is not active yet. Tap Restore Purchases."); }
+      if (isPremium(res)) { setFlag(false); openApp(false); } else { setBusy(false); say("Purchase finished but access is not active yet. Tap Restore Purchases."); }
     }).catch(function (err) {
       setBusy(false);
       if (err && (err.userCancelled || err.code === "1" || err.code === 1)) { say(""); return; }
@@ -206,7 +211,7 @@
     if (busy) return;
     tap(); say(""); setBusy(true);
     Purchases.restorePurchases().then(function (res) {
-      if (isPremium(res)) { openApp(); }
+      if (isPremium(res)) { setFlag(false); openApp(false); }
       else { setBusy(false); say("No active subscription was found for this Apple Account."); }
     }).catch(function (err) {
       setBusy(false); say((err && err.message) || "Could not restore purchases. Please try again.");
@@ -218,31 +223,53 @@
   }
 
   /* ---------- start ---------- */
+  function withTimeout(promise, ms, label) {
+    return new Promise(function (resolve, reject) {
+      var t = setTimeout(function () { reject(new Error("Timed out: " + label)); }, ms);
+      Promise.resolve(promise).then(function (v) { clearTimeout(t); resolve(v); }, function (e) { clearTimeout(t); reject(e); });
+    });
+  }
+  function fail(err, step) {
+    var detail = (err && (err.message || err.code)) ? String(err.message || err.code) : "unknown";
+    $("fatalText").textContent = "We could not load the subscription options. Please check your internet connection and tap Try again. (" + step + ": " + detail.slice(0, 160) + ")";
+    show("fatal");
+  }
+  var configured = false;
   function start() {
     show("loading");
+    var step = "start";
     if (!native && !MOCK) {
       $("fatalText").textContent = "Please open FTLR Fitness from the app on your iPhone.";
       show("fatal"); return;
     }
-    Purchases.configure({ apiKey: C.REVENUECAT_PUBLIC_KEY }).then(function () {
-      return Purchases.getCustomerInfo();
-    }).then(function (res) {
-      if (isPremium(res)) { openApp(); return null; }
-      return Purchases.getOfferings();
-    }).then(function (off) {
-      if (off === null) return;
-      var cur = off && off.current;
-      packages = (cur && cur.availablePackages || []).slice().sort(function (a, b) { return orderRank(a) - orderRank(b); });
-      if (!packages.length) throw new Error("No plans available");
-      selected = packages[0]; render(); show("paywall");
-    }).catch(function (err) {
-      $("fatalText").textContent = "Please check your internet connection and try again.";
-      show("fatal");
-    });
+    try {
+      if (!C || !C.REVENUECAT_PUBLIC_KEY) throw new Error("config missing");
+      step = "setup";
+      var first = configured ? Promise.resolve() : withTimeout(Purchases.configure({ apiKey: C.REVENUECAT_PUBLIC_KEY }), 15000, "setup");
+      first.then(function () {
+        configured = true;
+        step = "account";
+        return withTimeout(Purchases.getCustomerInfo(), 20000, "account");
+      }).then(function (res) {
+        if (isPremium(res)) { setFlag(false); openApp(false); return null; }
+        if (getFlag() && !backFromApp) { openApp(true); return null; }
+        step = "plans";
+        return withTimeout(Purchases.getOfferings(), 25000, "plans");
+      }).then(function (off) {
+        if (off === null) return;
+        var cur = off && off.current;
+        packages = (cur && cur.availablePackages || []).slice().sort(function (a, b) { return orderRank(a) - orderRank(b); });
+        if (!packages.length) throw new Error("No plans available");
+        selected = packages[0]; render(); show("paywall");
+      }).catch(function (err) { fail(err, step); });
+    } catch (e) { fail(e, step); }
   }
+  window.addEventListener("error", function (ev) { if ($("loading").classList.contains("on")) fail(ev && ev.error ? ev.error : new Error(ev.message), "page"); });
+  window.addEventListener("unhandledrejection", function (ev) { if ($("loading").classList.contains("on")) fail(ev && ev.reason, "page"); });
 
   $("buy").addEventListener("click", buy);
   $("restore").addEventListener("click", restore);
+  $("weblogin").addEventListener("click", function () { tap(); setFlag(true); openApp(true); });
   $("retry").addEventListener("click", start);
   $("terms").addEventListener("click", function () { openLink(C.TERMS_URL); });
   $("privacy").addEventListener("click", function () { openLink(C.PRIVACY_URL); });
